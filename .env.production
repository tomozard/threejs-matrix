# AI Voice Integration - Production Configuration

# Backend Service URLs (Configure these for your production environment)
NEXT_PUBLIC_BACKEND_BASE_URL=https://your-backend-domain.com
NEXT_PUBLIC_STT_WS_URL=wss://your-backend-domain.com/ws/stt
NEXT_PUBLIC_TTS_WS_URL=wss://your-backend-domain.com/tts/stream
NEXT_PUBLIC_CHAT_WS_URL=wss://your-backend-domain.com/chat/stream

# WebSocket Configuration (Production optimized)
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=2000
NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS=3
NEXT_PUBLIC_WS_CONNECTION_TIMEOUT=15000

# Audio Processing Configuration (Production optimized)
NEXT_PUBLIC_AUDIO_SAMPLE_RATE=16000
NEXT_PUBLIC_AUDIO_CHANNELS=1
NEXT_PUBLIC_AUDIO_BITS_PER_SAMPLE=16
NEXT_PUBLIC_AUDIO_FORMAT=pcm16
NEXT_PUBLIC_AUDIO_RECORDING_TIME_SLICE=200
NEXT_PUBLIC_AUDIO_MAX_RECORDING_DURATION=30000
NEXT_PUBLIC_AUDIO_BUFFER_SIZE=2048
NEXT_PUBLIC_AUDIO_PLAYBACK_LATENCY=100

# Visual Effects Configuration (Production optimized)
NEXT_PUBLIC_NORMAL_LARGE_FONT_PROPORTION=0.1
NEXT_PUBLIC_NORMAL_SPEED_MULTIPLIER=1.0
NEXT_PUBLIC_VOICE_ACTIVE_LARGE_FONT_PROPORTION=0.4
NEXT_PUBLIC_VOICE_ACTIVE_SPEED_MULTIPLIER=2.0
NEXT_PUBLIC_PROCESSING_LARGE_FONT_PROPORTION=0.3
NEXT_PUBLIC_PROCESSING_SPEED_MULTIPLIER=1.5
NEXT_PUBLIC_VISUAL_TRANSITION_DURATION=400

# Voice Button Configuration
NEXT_PUBLIC_VOICE_BUTTON_SIZE=60
NEXT_PUBLIC_VOICE_BUTTON_BOTTOM_OFFSET=30

# Keyboard Shortcuts Configuration
NEXT_PUBLIC_VOICE_TOGGLE_KEY= 
NEXT_PUBLIC_VOICE_STOP_KEY=Escape
NEXT_PUBLIC_MATRIX_PAUSE_KEY=KeyP

# Production Features (Security and performance focused)
NEXT_PUBLIC_ENABLE_DEBUG_LOGGING=false
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true